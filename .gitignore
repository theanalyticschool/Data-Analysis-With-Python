# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.gitattributes
# Default text files to LF
* text=auto eol=lf

# Python
*.py text eol=lf

# Configuration
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf

# Jupyter notebooks
*.ipynb text eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Virtual environments
.venv
